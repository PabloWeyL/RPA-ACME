# Perfil para el backend Django real; agregar variables al .env propio.
BACKEND_AUTH_MODE=weyland
BACKEND_API_URL=http://127.0.0.1:8000/api
BACKEND_LOGIN_URL=http://127.0.0.1:8000/api/auth/login
BACKEND_PERMITIR_HTTP_LOCAL=true
# HTTP solo se permite en loopback y con esta bandera. Produccion requiere HTTPS.
BACKEND_PROCESO_CODIGO=
BACKEND_TRABAJOS_DIR=temporales/weyland
# Completar solo en .env privado o inyectar en entorno. No compartir secretos.
BACKEND_EMAIL=
BACKEND_PASSWORD=
BACKEND_BOT_API_KEY=
# BACKEND_BOT_API_KEY debe coincidir con BOT_API_KEY del servidor.

# Tiempos HTTP configurables por maquina, en segundos.
BACKEND_TIMEOUT_CONEXION=10
BACKEND_TIMEOUT_LECTURA=60

# Ejecutar solo la solicitud seleccionada por el operador.
BACKEND_REUTILIZAR_ULTIMA=false

BACKEND_CONTRATO=cola_actual

BACKEND_MAQUINA_ID=

MAX_ADJUNTOS_BYTES=20971520

# Timeout de la suite del arranque automatico; maximo 3600 segundos.
PRUEBAS_TIMEOUT_SEGUNDOS=600

# consultar o descargar-reportes; debe corresponder al codigo registrado.
ACME_PROCESO_WEB=consultar

# Agregar estas variables al .env del bot o inyectarlas en el entorno.
# En la VM, obtener BACKEND_PASSWORD desde el gestor de secretos.
# El cliente no guarda access_token ni refresh_token en archivos.
BACKEND_API_URL=https://backend.example.com/api/v1
BACKEND_LOGIN_URL=https://backend.example.com/api/v1/auth/login
BACKEND_EMAIL=
BACKEND_PASSWORD=

BACKEND_AUTH_MODE=login

# IDENTIFICACION DE LA EJECUCION (se genera automaticamente; dejar vacio)
ID_EJECUCION=

# MODULOS
MODULO_CORREO=false
MODULO_CORREO_INICIAL=true
MODULO_SCRAPING=true

# IDENTIFICACION DEL PROCESO
NOMBRE_PROCESO=RPA_ACME
NOMBRE_PROCESO_TEXTO="Robot ACME: consulta de Work Items y descarga de reportes mensuales"

# RUTAS (RUTA_BASE vacio usa la carpeta del proyecto)
RUTA_BASE=
DB_PATH=temporales/acme.db
CARPETA_INPUTS=inputs
# Rutas individuales conservadas para compatibilidad con llamadas Python.
EXCEL_ENTRADA=inputs/filtros.xlsx
EXCEL_REPORTES_MENSUALES=inputs/reportes_mensuales.xlsx
# Se usa la carpeta del archivo; el nombre final es propio de cada ejecucion.
EXCEL_SALIDA=reportes/resultados.xlsx
CARPETA_CAPTURAS=capturas
CARPETA_DESCARGAS=descargas/reportes_mensuales
RUTA_HISTORICO=logs/

# CORREO SMTP (EMAIL_PASSWORD es una contrasena de aplicacion de Google)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_REMITENTE=
EMAIL_PASSWORD=
LISTA_DISTRIBUCION_CORREO=
# Inicio y resultados se envian a ambas listas; fallas criticas solo a ERROR.
LISTA_DISTRIBUCION_ERROR=
# Solo se envian notificaciones de inicio y final; no hay avisos de avance.

# ACME SYSTEM 1: ACCESO Y NAVEGADOR
ACME_EMAIL=
ACME_PASSWORD=
ACME_URL=https://acme-test.uipath.com
ACME_HEADLESS=true
ACME_TIMEOUT=25
TAGUI_ORIGEN=

# PLANTILLA ORIGINAL: RESERVADO, SIN INTEGRACION ACTIVA
KEYVAULT_NAME=
DB_SQLITE=
DB_SERVER=
DB_NAME=acme.db
MONITOR_DB_SERVER=
MONITOR_DB_NAME=
ID_PROCESO_MONITOR=
ODBC_DRIVER=
MONITOR_USER=
MONITOR_PASSWORD=
RETENCION_LOGS_MESES=12

# REINTENTOS (el correo no se reenvia automaticamente)
MAX_REINTENTOS=3
MAX_REINTENTOS_CORREO=1

# EJECUTOR API (opcional; main.py sigue funcionando sin estas variables)
# Incluye el prefijo de la API; no agrega /api/rpa automaticamente.
BACKEND_API_URL=https://backend.example.com/api/rpa
# login es el modo predeterminado; token solo para compatibilidad explicita.
BACKEND_AUTH_MODE=login
BACKEND_LOGIN_URL=https://backend.example.com/api/rpa/auth/login
BACKEND_EMAIL=bot-acme@example.test
BACKEND_PASSWORD=
BACKEND_API_TOKEN=
ROBOT_ID=acme-windows-01
INTERVALO_CONSULTA_SEGUNDOS=10

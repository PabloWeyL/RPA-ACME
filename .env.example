# Copiar a .env privado y completar los valores reales antes de ejecutar.
ENTORNO=DESARROLLO
NOMBRE_PROCESO=RPA_ACME
NOMBRE_PROCESO_TEXTO=Consulta de Work Items y descarga de reportes mensuales
MODULO_SCRAPING=true
MODULO_CORREO=false
MODULO_CORREO_INICIAL=true

# Credenciales y navegador de ACME System 1.
ACME_EMAIL=
ACME_PASSWORD=
ACME_URL=https://acme-test.uipath.com
ACME_HEADLESS=true
ACME_TIMEOUT=25
TAGUI_ORIGEN=
MAX_REINTENTOS=3

# Conexion al backend actual. En produccion usar HTTPS.
BACKEND_AUTH_MODE=weyland
BACKEND_CONTRATO=cola_actual
BACKEND_API_URL=http://127.0.0.1:8000/api
BACKEND_LOGIN_URL=http://127.0.0.1:8000/api/auth/login
BACKEND_PERMITIR_HTTP_LOCAL=true
BACKEND_EMAIL=
BACKEND_PASSWORD=
BACKEND_BOT_API_KEY=
BACKEND_MAQUINA_ID=
BACKEND_PROCESO_CODIGO=
BACKEND_TRABAJOS_DIR=temporales/weyland
BACKEND_REUTILIZAR_ULTIMA=false
BACKEND_TIMEOUT_CONEXION=10
BACKEND_TIMEOUT_LECTURA=60
# consultar o descargar-reportes; debe corresponder al codigo registrado.
ACME_PROCESO_WEB=consultar

# Rutas locales; el modo web aisla sus datos por ejecucion.
RUTA_BASE=
DB_PATH=temporales/acme.db
CARPETA_INPUTS=input
EXCEL_ENTRADA=input/filtros.xlsx
EXCEL_REPORTES_MENSUALES=input/reportes_mensuales.xlsx
EXCEL_SALIDA=reportes/resultados.xlsx
CARPETA_CAPTURAS=capturas
CARPETA_DESCARGAS=descargas/reportes_mensuales
RUTA_HISTORICO=logs
RETENCION_LOGS_MESES=12

# Completar SMTP y listas antes de activar MODULO_CORREO.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_REMITENTE=
EMAIL_PASSWORD=
LISTA_DISTRIBUCION_ERROR=
LISTA_DISTRIBUCION_CORREO=
MAX_ADJUNTOS_BYTES=20971520
MAX_REINTENTOS_CORREO=1
